      "statement": {
        "_type": "https://in-toto.io/Statement/v1",
        "subject": [
          {
            "name": "tool-linux-x64.tar.xz",
            "digest": {
              "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          },
          {
            "name": "tool-windows-x64.zip",
