// packslip.sh: packslip's install scripts, served from the release files in
// R2 by worker.mjs. Deployed by .github/workflows/site.yml, beside
// packslip.dev but as a Worker of its own, so the installer's host serves
// nothing but the scripts.
{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "packslip-sh",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "account_id": "6e243906ff257b965bcae8025c2fc344",
  "workers_dev": false,
  "preview_urls": false,
  // packslip.sh is attached to this Worker as a custom domain, set up once
  // by hand (see RELEASING.md), for the same reason as packslip.dev's: a
  // deploy then needs no zone permissions.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "jdx-releases" }],
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "jdx_downloads" }],
  "vars": { "TOOL": "packslip" }
}
