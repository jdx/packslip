// @generated by `packslip usage`
name packslip
bin packslip
version "0.3.0"
author "Jeff Dickey <@jdx>"
about "A signed release manifest: what shipped, and how to verify it"
long_about #"""
A signed release manifest: what shipped, and how to verify it

A vendor runs `packslip create` in its release job to publish one signed document listing every artifact. Consumers verify it with `packslip verify` against a pinned identity or key. See https://packslip.dev.
"""#
arg_required_else_help #true
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd create help="Create and sign a packslip for a release" {
    long_help #"""
Create and sign a packslip for a release

Digests every artifact, infers os/arch/libc/format from file names (override with path:os/arch[/libc], add @variant to tell apart two builds for one platform), and writes packslip.sigstore.json into --out. Inside a CI job the document is signed keylessly with the job's identity. With --key it is signed with an Ed25519 key from `packslip keygen`. Either way the signature is logged to Rekor.
"""#
    flag --project help="The project's name: a host path such as github.com/owner/repo, or github.com/owner/repo/tool for one tool of a monorepo" required=#true {
        arg <PROJECT>
    }
    flag --version help="The release version" required=#true {
        arg <VERSION>
    }
    flag "-k --key" help="Sign with this secret key instead of a CI identity" {
        arg <KEY>
    }
    flag --sign help="How to sign; defaults to key when --key is given, else oidc" {
        arg <SIGN>
    }
    flag --no-log help="With --key: do not record the signature in Rekor. Consumers must then opt in with --allow-unlogged"
    flag "-o --out" help="Directory to write into" default=. {
        arg <OUT>
    }
    flag --url-base help="Download URL prefix for the artifacts" {
        arg <URL_BASE>
    }
    flag --url help="Download URL for one artifact, as FILENAME=URL (repeatable)" var=#true {
        arg <URL>
    }
    flag --source-repo help="Source repository URL" {
        arg <SOURCE_REPO>
    }
    flag --commit help="Source commit" {
        arg <COMMIT>
    }
    flag --tag help="Source tag" {
        arg <TAG>
    }
    flag --published-at help="RFC 3339 publish time; defaults to now" {
        arg <PUBLISHED_AT>
    }
    flag --prerelease help="Mark the release as not for general use"
    flag --channel help="The release channel: stable, beta, nightly" {
        arg <CHANNEL>
    }
    flag --version-order help="How consumers order this project's versions: source (the release list's order, the default) or semver (strict MAJOR.MINOR.PATCH, calver included)" {
        arg <VERSION_ORDER>
    }
    flag --notes-url help="URL of the release notes" {
        arg <NOTES_URL>
    }
    flag --sbom help="SBOM URL" {
        arg <SBOM>
    }
    flag --bin help="Executable inside every archive, as PATH or NAME=PATH (repeatable)" var=#true {
        arg <BIN>
    }
    flag --resource help="Something else the release ships, as KIND[/QUALIFIER]=SOURCE:VALUE where SOURCE is archive (a path inside every archive), asset (a separate release file, by local path), repo (a path at --commit), or exec (a command whose stdout is the file). Kinds: completion/SHELL (or completion/SHELL,SHELL with exec and a {shell} placeholder), man, cli-spec/FORMAT[/BIN], skill/NAME, desktop, icon, app. Example: 'completion/zsh=archive:share/zsh/site-functions/_tool' (repeatable)" var=#true {
        arg <RESOURCE>
    }
    flag --provenance help="Provenance URL for every artifact (repeatable, positional order)" var=#true {
        arg <PROVENANCE>
    }
    flag --attested-by help="Who makes the claim: vendor (default) or repackager" {
        arg <ATTESTED_BY>
    }
    flag --evidence help="What a repackager checked, as KIND or KIND=DETAIL (repeatable)" var=#true {
        arg <EVIDENCE>
    }
    flag --no-sha512 help="Record only sha256, not sha512 as well"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <ARTIFACTS>... help="Artifact files, optionally as path[:os/arch[/libc]][@variant]"
    complete key type=path
}
cmd keygen help="Generate an Ed25519 key pair for the sigstore-key scheme" {
    long_help #"""
Generate an Ed25519 key pair for the sigstore-key scheme

Only needed outside a CI job: with an OIDC identity, `create` signs keylessly and needs no key. Writes the secret seed to the given path (mode 0600) and a minisign-format public key beside it with a .pub extension.
"""#
    flag "-o --out" help="Where to write the secret key" default=packslip.key {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd releases help="Create and sign a project's release list" {
    long_help #"""
Create and sign a project's release list

For a project on its own domain: lists released packslips with their digests so consumers can discover releases, with an expiry and a sequence number so they notice a stale or truncated list. Publish the result at https://<host>/.well-known/packslip/<path>.json.
"""#
    flag --project help="The project's name, which every listed packslip must carry" required=#true {
        arg <PROJECT>
    }
    flag --sequence help="Increases with every list published" required=#true {
        arg <SEQUENCE>
    }
    flag --version-order help="How consumers order the listed versions: source (this list's order, the default) or semver" {
        arg <VERSION_ORDER>
    }
    flag --valid-for help="How long the list stays current: 30d, 12h, 2w" default="30d" {
        arg <VALID_FOR>
    }
    flag --generated-at help="RFC 3339 generation time; defaults to now" {
        arg <GENERATED_AT>
    }
    flag --release help="A released packslip as URL=PATH: where consumers fetch it, and the local copy to read (repeatable)" required=#true var=#true {
        arg <RELEASE>
    }
    flag --yank help="Mark a listed release withdrawn, as URL=REASON (repeatable)" var=#true {
        arg <YANK>
    }
    flag --security help="Mark a listed release as a security fix, by URL (repeatable)" var=#true {
        arg <SECURITY>
    }
    flag "-k --key" help="Sign with this secret key instead of a CI identity" {
        arg <KEY>
    }
    flag --sign help="How to sign; defaults to key when --key is given, else oidc" {
        arg <SIGN>
    }
    flag --no-log help="With --key: do not record the signature in Rekor"
    flag "-o --out" help="Where to write the list" default=packslip-releases.sigstore.json {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete key type=path
}
cmd schema help="Print the JSON schema of the release statement, or of the release list" {
    flag --releases help="The releases/v1 list instead of the release/v1 statement"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd show help="Print the statement inside a bundle, without verifying it" {
    flag --raw help="The exact signed bytes instead of pretty JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="The packslip.sigstore.json (or release list) to read"
    complete bundle type=path
}
cmd usage help="Generate a usage spec for the CLI" hide=#true {
    long_help #"""
Generate a usage spec for the CLI

https://usage.jdx.dev
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd verify help="Verify a packslip, or a release list, against a pinned identity or key" {
    long_help #"""
Verify a packslip, or a release list, against a pinned identity or key

Checks the bundle's signature and log entry, the statement, and the digest and size of every artifact file given. Exits 1 on any failure. A keyless document is checked against --identity, --identity-prefix, and --issuer, or, for a project on github.com or gitlab.com, against the repository the project name says signed it. A key-signed document is checked against --pubkey.
"""#
    flag "-p --pubkey" help="The pinned public key file, or its base64 line" {
        arg <PUBKEY>
    }
    flag --identity help="The exact certificate identity a keyless signer must have" {
        arg <IDENTITY>
    }
    flag --identity-prefix help="A prefix the certificate identity must start with, such as https://github.com/owner/repo/" {
        arg <IDENTITY_PREFIX>
    }
    flag --issuer help="The OIDC issuer a keyless signer must have" {
        arg <ISSUER>
    }
    flag --allow-unlogged help="Accept a bundle without a transparency log entry"
    flag --trusted-root help="A sigstore trusted_root.json to use instead of the embedded one" {
        arg <TRUSTED_ROOT>
    }
    flag "-a --artifact" help="Artifact files to check against the document" var=#true {
        arg <ARTIFACT>
    }
    flag "-J --json" help="Print the result as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="The packslip.sigstore.json to verify"
    complete bundle type=path
    complete trusted_root type=path
}
cmd version help="Show the version" {
    alias v
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
