// @generated by `packslip usage`
name packslip
bin packslip
version "1.2.0"
author "Jeff Dickey <@jdx>"
about "A signed release manifest: what shipped, and how to verify it"
long_about #"""
A signed release manifest: what shipped, and how to verify it

A vendor runs `packslip create` in its release job to publish one signed document listing every artifact. Consumers verify it with `packslip verify` against a pinned identity or key. See https://packslip.dev.
"""#
arg_required_else_help #true
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd completion help="Generate a self-contained shell completion script" {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SHELL> help="Shell to generate completions for" {
        choices bash elvish zsh fish nu nushell powershell pwsh
    }
}
cmd create help="Create and sign a packslip for a release" {
    long_help #"""
Create and sign a packslip for a release

Hash local artifacts, infer platforms and formats from filenames, and write a signed bundle to --out. Use --manifest for per-artifact paths, formats, requirements, and scoped resources. No files are uploaded.

Signing uses a supported CI OIDC identity by default. Use --key to sign with an Ed25519 key instead. Signatures are logged to Rekor unless a key-signed release explicitly uses --no-log.

Examples and configuration: https://packslip.dev/docs/describing-releases/
"""#
    flag --project help="The project's name: a host path such as github.com/owner/repo, or github.com/owner/repo/tool for one tool of a monorepo. Required unless the manifest names it" {
        arg <PROJECT>
    }
    flag --version help="Semver release version, such as 1.2.3. Required unless set in the manifest" {
        arg <VERSION>
    }
    flag "-m --manifest" help="A TOML manifest giving per-artifact executables, formats, requirements, platforms, and the release's resources; see https://packslip.dev/docs/describing-releases/" {
        arg <MANIFEST>
    }
    flag "-k --key" help="Sign with this secret key instead of a CI identity" {
        arg <KEY>
    }
    flag --sign help="How to sign; defaults to key when --key is given, else oidc" {
        arg <SIGN>
    }
    flag --no-log help="With --key: do not record the signature in Rekor. Consumers must then opt in with --allow-unlogged"
    flag "-o --out" help="Directory for the signed bundle (does not copy artifacts)" default=. {
        arg <OUT>
    }
    flag --url-base help="Download URL prefix for the artifacts" {
        arg <URL_BASE>
    }
    flag --url help="Download URL for one artifact or resource asset, as FILENAME=URL (repeatable)" var=#true {
        arg <URL>
    }
    flag --format help="Format of one artifact whose name does not say, as FILENAME=FORMAT: an archive (tar.xz, tar.gz, tar.zst, tar.bz2, tgz, tar, zip, 7z), a single compressed executable (gz, xz, zst, bz2), an installer (deb, rpm, dmg, pkg, msi, msix, exe, appimage), raw for a bare executable, or a type of your own (repeatable)" var=#true {
        arg <FORMAT>
    }
    flag --source-repo help="Source repository URL" {
        arg <SOURCE_REPO>
    }
    flag --commit help="Source commit" {
        arg <COMMIT>
    }
    flag --tag help="Source tag" {
        arg <TAG>
    }
    flag --published-at help="RFC 3339 publish time; defaults to now" {
        arg <PUBLISHED_AT>
    }
    flag --notes-url help="URL of the release notes" {
        arg <NOTES_URL>
    }
    flag --extension help="Release-level extension as NAME=JSON, where NAME is who defines it (a consumer such as mise, or a domain the vendor controls) and JSON is its value. Example: 'example.com={\"build_id\":\"20260901.3\"}' (repeatable)" var=#true {
        arg <EXTENSION>
    }
    flag --bin help="Executable inside every artifact, as PATH or NAME=PATH; for a bare executable, the name it gets on PATH (repeatable)" var=#true {
        arg <BIN>
    }
    flag --resource help="Something else the release ships, as KIND[/QUALIFIER][@os[/arch[/libc]]]=SOURCE:VALUE where SOURCE is archive (a path inside every archive), asset (a separate release file, by local path), repo (a path at --commit), or exec (a command whose stdout is the file). Kinds: completion/SHELL (or completion/SHELL,SHELL with exec and a {shell} placeholder), man[/BIN], cli-spec/FORMAT[/BIN], skill/NAME, sbom/FORMAT, desktop, icon, app. An @ scope limits the entry to the artifacts of that platform, for a layout that differs across them; the manifest also scopes to one exact artifact. Examples: 'completion/zsh=archive:share/zsh/site-functions/_tool', 'man@linux=archive:share/man/man1/tool.1' (repeatable)" var=#true {
        arg <RESOURCE>
    }
    flag --provenance help="Provenance URL for an artifact, as FILENAME=URL, or bare URLs in the order the artifacts are given (repeatable)" var=#true {
        arg <PROVENANCE>
    }
    flag --attested-by help="Who makes the claim: vendor (default) or repackager" {
        arg <ATTESTED_BY>
    }
    flag --evidence help="What a repackager checked, as KIND or KIND=DETAIL (repeatable)" var=#true {
        arg <EVIDENCE>
    }
    flag --no-sha512 help="Record only sha256, not sha512 as well"
    flag --require help="A command the executables need on PATH, as bin:NAME or bin:NAME@MIN where MIN is the lowest version that works. Example: bin:java@17 (repeatable)" var=#true {
        arg <REQUIRE>
    }
    flag --no-libs help="Do not open the artifacts to record the shared libraries their executables load from the host"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARTIFACTS]..." help="Artifact files, optionally as path[:os/arch[/libc]|:any][@variant]. Added to those the manifest lists"
    complete manifest type=path
    complete key type=path
}
cmd keygen help="Generate an Ed25519 key pair for the sigstore-key scheme" {
    long_help #"""
Generate an Ed25519 key pair for the sigstore-key scheme

Writes a secret seed to --out (mode 0600 on Unix) and a minisign-format public key beside it with a .pub extension. Refuses to overwrite either file. Keep the secret private; distribute the public key to consumers. A supported CI OIDC identity can sign without a long-lived key.
"""#
    flag "-o --out" help="Where to write the secret key" default=packslip.key {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd releases help="Create and sign a project's release list" {
    long_help #"""
Create and sign a project's release list

Read local release bundles and write a signed index with their digests, versions, expiry, and sequence. Repeat --release for every entry to keep; this command does not append to a previous list or upload the output.

Publish at the project's well-known location, or as a supplementary list on a GitHub repository's default branch. See https://packslip.dev/docs/release-lists/.
"""#
    flag --project help="The project's name, which every listed packslip must carry" required=#true {
        arg <PROJECT>
    }
    flag --sequence help="Increases with every list published" required=#true {
        arg <SEQUENCE>
    }
    flag --latest help="Recommend this exact listed version for unconstrained latest requests" {
        arg <LATEST>
    }
    flag --valid-for help="How long the list stays current: 30d, 12h, 2w" default="30d" {
        arg <VALID_FOR>
    }
    flag --generated-at help="RFC 3339 generation time; defaults to now" {
        arg <GENERATED_AT>
    }
    flag --release help="A released packslip as URL=PATH: where consumers fetch it, and the local copy to read (repeatable)" required=#true var=#true {
        arg <RELEASE>
    }
    flag --yank help="Mark a listed release withdrawn, as URL=REASON (repeatable)" var=#true {
        arg <YANK>
    }
    flag --security help="Mark a listed release as a security fix, by URL (repeatable)" var=#true {
        arg <SECURITY>
    }
    flag --evidence help="What a publisher other than the vendor checked about a listed release, as URL=KIND or URL=KIND=DETAIL (repeatable)" var=#true {
        arg <EVIDENCE>
    }
    flag "-k --key" help="Sign with this secret key instead of a CI identity" {
        arg <KEY>
    }
    flag --sign help="How to sign; defaults to key when --key is given, else oidc" {
        arg <SIGN>
    }
    flag --no-log help="With --key: do not record the signature in Rekor"
    flag "-o --out" help="Where to write the list" default=packslip-releases.sigstore.json {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete key type=path
}
cmd schema help="Print the JSON schema for a decoded release statement" {
    long_help #"""
Print the JSON schema for a decoded release statement

Use --releases for the release-list statement schema. These schemas describe the in-toto payload, not the enclosing sigstore bundle.
"""#
    flag --releases help="The releases/v1 list instead of the release/v1 statement"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd show help="Print the statement inside a bundle, without verifying it" {
    flag --raw help="Print the signed payload followed by a newline, without pretty-printing"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="The packslip.sigstore.json (or release list) to read"
    complete bundle type=path
}
cmd usage help="Generate a usage spec for the CLI" hide=#true {
    long_help #"""
Generate a usage spec for the CLI

https://usage.jdx.dev
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd verify help="Verify a packslip, or a release list, against a pinned identity or key" {
    long_help #"""
Verify a packslip, or a release list, against a pinned identity or key

Check the signature, log evidence, and statement structure. With --artifact, also check local files against signed digests and artifact sizes. Without it, only the bundle is checked. Verification failures exit with status 1; no remote artifacts or provenance are fetched.

Pin a keyless signer with --identity or --identity-prefix and --issuer, or a signing key with --pubkey. Without an explicit pin, derive the policy from the document's claimed GitHub or GitLab project. Consumers must separately match the project and version to their intended request. For release lists, expiry and remembered sequence checks are the consumer's responsibility. See https://packslip.dev/docs/verifying/.
"""#
    flag "-p --pubkey" help="The pinned public key file, or its base64 line" {
        arg <PUBKEY>
    }
    flag --identity help="The exact certificate identity a keyless signer must have" {
        arg <IDENTITY>
    }
    flag --identity-prefix help="A prefix the certificate identity must start with, such as https://github.com/owner/repo/" {
        arg <IDENTITY_PREFIX>
    }
    flag --issuer help="The OIDC issuer a keyless signer must have" {
        arg <ISSUER>
    }
    flag --allow-unlogged help="Accept a bundle without a transparency log entry"
    flag --trusted-root help="A sigstore trusted_root.json to use instead of the embedded one" {
        arg <TRUSTED_ROOT>
    }
    flag "-a --artifact" help="Local artifacts or resource assets to check (repeatable; not downloaded)" var=#true {
        arg <ARTIFACT>
    }
    flag "-J --json" help="Print the result as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="Local release bundle or signed release list to verify"
    complete bundle type=path
    complete trusted_root type=path
}
cmd version help="Show the version" {
    alias v
    flag "-J --json" help="Print as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
