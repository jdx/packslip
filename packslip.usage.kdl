// @generated by `packslip usage`
name packslip
bin packslip
version "1.5.0"
author "Jeff Dickey <@jdx>, Shunsuke Suzuki <@suzuki-shunsuke>"
about "A signed release manifest: what shipped, and how to verify it"
long_about #"""
A signed release manifest: what shipped, and how to verify it

A vendor runs `packslip create` in its release job to sign one document listing every artifact, then uploads it beside them. Consumers check that document, and the files they download, with `packslip verify` against a pinned identity, key, or signer fingerprint. See https://packslip.dev.
"""#
arg_required_else_help #true
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd completion help="Generate a self-contained shell completion script" {
    long_help #"""
Generate a self-contained shell completion script

Print the script to stdout. Redirect it to a file where your shell loads completions, as in the example. The script asks the installed packslip for candidates, so it needs no other tool and keeps working after upgrades.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SHELL> help="Shell to generate completions for" {
        choices bash elvish zsh fish nu nushell powershell pwsh
    }
    example "mkdir -p ~/.local/share/bash-completion/completions && packslip completion bash > ~/.local/share/bash-completion/completions/packslip" header="Install bash completions for your user"
}
cmd create help="Create and sign a packslip for a release" {
    long_help #"""
Create and sign a packslip for a release

Hash local artifacts, infer platforms and formats from file names, and write the signed bundle (packslip.sigstore.json, or a per-tool name for a GitHub monorepo tool; see --out) into the --out directory. Use --manifest for per-artifact paths, formats, requirements, and scoped resources. No files are uploaded.

By default, create signs keyless with an OIDC token: the one in SIGSTORE_ID_TOKEN when it is set, or else the CI job's own identity, which on GitHub Actions needs the `id-token: write` permission. Pass --key to sign with a key from `packslip keygen` instead. Either way, the signature is recorded in the Rekor transparency log. With --key, --no-log skips the log entry, and consumers must then accept the release with --allow-unlogged.

The TOML manifest and more examples: https://packslip.dev/docs/describing-releases/
"""#
    flag --project help="The project's name: a host path such as github.com/owner/repo, or github.com/owner/repo/tool for one tool of a monorepo. Required unless the manifest sets it" help_heading=Input {
        arg <PROJECT>
    }
    flag --version help="Semver release version, such as 1.2.3. Required unless the manifest sets it" help_heading=Input {
        arg <VERSION>
    }
    flag "-m --manifest" help="A TOML manifest giving per-artifact executables, formats, requirements, platforms, and the release's resources; its artifact and asset paths are relative to the working directory, not to the manifest. See https://packslip.dev/docs/describing-releases/#use-a-toml-manifest" help_heading=Input {
        arg <MANIFEST>
    }
    flag "-k --key" help="Sign with this secret key instead of a CI identity" help_heading=Signing {
        arg <KEY>
    }
    flag --sign help="How to sign: oidc (keyless) or key (needs --key). Optional; inferred from whether --key is given" help_heading=Signing {
        arg <SIGN>
    }
    flag --no-log help="With --key: do not record the signature in Rekor. Consumers must then opt in with --allow-unlogged" help_heading=Signing
    flag "-o --out" help="Directory to write the bundle into, created if missing" help_heading=Output default=. {
        long_help #"""
Directory to write the bundle into, created if missing

The bundle is packslip.sigstore.json, or packslip.TOOL.sigstore.json for a tool in a GitHub monorepo, such as github.com/owner/repo/TOOL (a deeper path has each / replaced by -). An existing bundle is replaced. Artifacts are not copied.
"""#
        arg <OUT>
    }
    flag --url-base help="Download URL prefix: each artifact and resource asset gets PREFIX/FILENAME unless --url or the manifest gives its URL" help_heading="Download URLs" {
        arg <URL_BASE>
    }
    flag --url help="Download URL for one artifact or resource asset, as FILENAME=URL (repeatable)" var=#true help_heading="Download URLs" {
        arg <URL>
    }
    flag --format help="Format of one artifact whose name does not say, as FILENAME=FORMAT: an archive (tar.xz, tar.gz, tar.zst, tar.bz2, tgz, tar, zip, 7z), a single compressed executable (gz, xz, zst, bz2), an installer (deb, rpm, dmg, pkg, msi, msix, exe, appimage), raw for a bare executable, or a type of your own (repeatable)" var=#true help_heading=Artifacts {
        arg <FORMAT>
    }
    flag --source-repo help="Source repository URL, such as https://github.com/owner/repo" help_heading=Source {
        arg <SOURCE_REPO>
    }
    flag --commit help="Commit the release was built from; needs --source-repo or the manifest's source.repo. A resource with a repo: source requires it, and consumers read that file at this commit" help_heading=Source {
        arg <COMMIT>
    }
    flag --tag help="Git tag of the release, such as v1.2.3; needs --source-repo or the manifest's source.repo" help_heading=Source {
        long_help #"""
Git tag of the release, such as v1.2.3; needs --source-repo or the manifest's source.repo

Consumers that list a GitHub project's versions from its tags do not see the release when the tag does not name the release's version, unless a signed release list names the release. create warns when that happens.
"""#
        arg <TAG>
    }
    flag --published-at help="RFC 3339 publish time; defaults to now" help_heading="Release metadata" {
        arg <PUBLISHED_AT>
    }
    flag --notes-url help="URL of the release notes" help_heading="Release metadata" {
        arg <NOTES_URL>
    }
    flag --extension help="Release-level extension as NAME=JSON, where NAME is who defines it (a consumer such as mise, or a domain the vendor controls) and JSON is its value. Example: 'example.com={\"build_id\":\"20260901.3\"}' (repeatable)" var=#true help_heading="Release metadata" {
        arg <EXTENSION>
    }
    flag --bin help="Executable in every artifact: a NAME to find inside each archive, a PATH from the archive root, or NAME=PATH when the command's name differs from the file's (repeatable)" var=#true help_heading=Artifacts {
        long_help #"""
Executable in every artifact: a NAME to find inside each archive, a PATH from the archive root, or NAME=PATH when the command's name differs from the file's (repeatable)

A PATH includes any top-level directory of the archive. For a bare executable, give the command name it installs as.
"""#
        arg <BIN>
    }
    flag --resource help="Another file the release ships, such as a completion script, man page, or SBOM, as KIND[/QUALIFIER][@OS[/ARCH[/LIBC]]]=SOURCE:VALUE (repeatable)" var=#true help_heading=Resources {
        long_help #"""
Another file the release ships, such as a completion script, man page, or SBOM, as KIND[/QUALIFIER][@OS[/ARCH[/LIBC]]]=SOURCE:VALUE (repeatable)

SOURCE is archive (a path inside the artifact, from its root), asset (a separate release file, by local path), repo (a path in the source repository at --commit), or exec (a command whose stdout is the file; leading NAME=value words set its environment).

Known kinds: completion/SHELL[/BIN] (completion/SHELL,SHELL[/BIN] with exec and a {shell} placeholder), man[/BIN], cli-spec/FORMAT[/BIN], skill/NAME, sbom/FORMAT, desktop, icon, app. Any other kind takes at most one qualifier, its name.

An @ scope limits the entry to the artifacts of that platform, for a layout that differs across them; release.toml can also limit an entry to one artifact. Examples: 'completion/zsh=archive:share/zsh/site-functions/_tool', 'man@linux=archive:share/man/man1/tool.1'. See https://packslip.dev/docs/resources/#write-a-resource-entry
"""#
        arg <RESOURCE>
    }
    flag --provenance help="Provenance URL for an artifact, as FILENAME=URL, or bare URLs in the order of the ARTIFACTS arguments (repeatable)" var=#true help_heading=Artifacts {
        arg <PROVENANCE>
    }
    flag --attested-by help="Who makes the claim: vendor (default) or repackager" help_heading=Repackagers {
        arg <ATTESTED_BY>
    }
    flag --evidence help="What a repackager checked, as KIND or KIND=DETAIL (repeatable)" var=#true help_heading=Repackagers {
        arg <EVIDENCE>
    }
    flag --no-sha512 help="Record only sha256, not sha512 as well" help_heading=Artifacts
    flag --require help="A command the executables need on PATH, as bin:NAME or bin:NAME@MIN where MIN is the lowest version that works. Example: bin:java@17 (repeatable)" var=#true help_heading=Artifacts {
        arg <REQUIRE>
    }
    flag --no-libs help="Do not read the executables for the shared libraries and C library they load from the host" help_heading=Artifacts {
        long_help #"""
Do not read the executables for the shared libraries and C library they load from the host

With this flag, create still finds each --bin inside the archives but does not derive requires.libs; a libs list in release.toml is recorded as written, unchecked. A Linux artifact whose platform and file name give no C library is recorded as gnu, even a static build.
"""#
    }
    flag --no-pin-workflow help="Keyless only: write identity.pin_workflow: false, so consumers hold later releases to the signing repository instead of to the workflow file that signs this one" help_heading=Signing {
        long_help #"""
Keyless only: write identity.pin_workflow: false, so consumers hold later releases to the signing repository instead of to the workflow file that signs this one

For a vendor whose releases are signed by more than one workflow of its repository. The signer must still be a workflow of that repository. A consumer that last accepted a release without the flag refuses the first one with it until a person approves it. See https://packslip.dev/release/v1/#reusable-workflows
"""#
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARTIFACTS]..." help="Files to describe, each as PATH, PATH:OS/ARCH[/LIBC], or PATH:any, with an optional @VARIANT" {
        long_help #"""
Files to describe, each as PATH, PATH:OS/ARCH[/LIBC], or PATH:any, with an optional @VARIANT

Without a platform suffix, create infers the platform from the file name. Give any as ARCH or LIBC to leave that field out, for a build that runs on every architecture or C library; PATH:any leaves out OS, ARCH, and LIBC. These files join the manifest's artifacts; a file the manifest lists under the same file name keeps its manifest entry, and its platform suffix and @VARIANT here are ignored.
"""#
    }
    complete manifest type=path
    complete key type=path
    example #"""
packslip create \
        --project github.com/owner/mytool \
        --version 1.2.3 \
        --bin mytool \
        --url-base https://github.com/owner/mytool/releases/download/v1.2.3 \
        --out dist \
        dist/mytool-1.2.3-linux-x64.tar.gz \
        dist/mytool-1.2.3-darwin-arm64.tar.gz
"""# header="Sign keyless in a CI job"
    example "packslip create --manifest release.toml --out dist" header="Describe the artifacts in a TOML manifest"
    example #"""
packslip create \
        --project mytool.example.com \
        --version 1.2.3 \
        --bin mytool \
        --url-base https://mytool.example.com/v1.2.3 \
        --key release.key \
        --out dist \
        dist/mytool-1.2.3-linux-x64.tar.gz
"""# header="Sign with a key from packslip keygen"
}
cmd install help="Install an authenticated upstream release and export its declared commands" {
    long_help #"""
Install an authenticated upstream release and export its declared commands

Keeps the complete installation tree. Does not run downloaded code, install dependencies, or edit shell configuration. Use --system for a shared install.
"""#
    flag --version help="Version, prefix, tag, or latest (the default)" {
        arg <VERSION>
    }
    flag --system help="Install for all users; Unix root uses this scope by default"
    flag --user help="Explicitly select the current user's installation scope"
    flag --force help="Replace conflicting command entries and unmarked installation directories"
    flag --offline help="Use only locally cached, authenticated metadata and artifacts"
    flag --install-dir help="Override the installation tree without moving trust state" {
        arg <INSTALL_DIR>
    }
    flag --bin-dir help="Override the command directory without moving trust state" {
        arg <BIN_DIR>
    }
    flag --variant help="Select a publisher's named variant" {
        arg <VARIANT>
    }
    flag --pin help="Allowed signer fingerprint (repeatable, alternatives within this option)" var=#true {
        arg <PIN>
    }
    flag --pubkey help="Ed25519 public key or path to its public-key file" {
        arg <PUBKEY>
    }
    flag --issuer help="Require this OIDC issuer as well as the project's default identity" {
        arg <ISSUER>
    }
    flag --identity help="Require this exact certificate identity" {
        arg <IDENTITY>
    }
    flag --identity-prefix help="Require this certificate identity prefix" {
        arg <IDENTITY_PREFIX>
    }
    flag --accept-trust-change help="Approve one exact displayed trust-change proposal (repeatable)" var=#true {
        arg <ACCEPT_TRUST_CHANGE>
    }
    flag --trusted-root help="Administrator-supplied Sigstore trusted_root.json instead of TUF refresh" {
        arg <TRUSTED_ROOT>
    }
    flag --allow-unlogged help="Accept signatures without transparency-log entries for this attempt"
    flag --allow-incompatible-host help="Accept the selected artifact's incompatible host requirements"
    flag --max-extracted-size help="Local maximum expanded archive size in bytes" default="10737418240" {
        arg <MAX_EXTRACTED_SIZE>
    }
    flag --max-archive-entries help="Local maximum archive entry count" default="100000" {
        arg <MAX_ARCHIVE_ENTRIES>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PROJECT> help="Project name (owner/repo, github.com/owner/repo[/subpath], or host[/path])"
    complete install_dir type=dir
    complete bin_dir type=dir
    complete trusted_root type=path
}
cmd keygen help="Generate an Ed25519 key pair for key-signed releases (sigstore-key)" {
    long_help #"""
Generate an Ed25519 key pair for key-signed releases (sigstore-key)

Write a new secret key to --out (a hex Ed25519 seed, mode 0600 on Unix) and its public key, in minisign format, to the same path with the extension replaced by .pub: --out release.key writes release.key and release.pub. Refuses to overwrite either file.

Sign with `packslip create --key release.key`, and give consumers release.pub for `packslip verify --pubkey`. Keep the secret key private. A CI job with an OIDC identity can sign keyless and needs no key.
"""#
    flag "-o --out" help="Where to write the secret key" default=packslip.key {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    example "packslip keygen --out release.key" header="Write release.key and release.pub"
}
cmd pin help="Print the signer fingerprint of a project's keyless releases" {
    long_help #"""
Print the signer fingerprint of a project's keyless releases

Verify a release bundle and print the signer fingerprint of the repository that signed it: `ps1_` and 26 characters. Run it on a release you already trust, because it fingerprints whichever repository signed the bundle it is given. A vendor publishes the fingerprint where consumers can read it without trusting a release, such as its README, and a consumer records it in its own configuration, such as a Dockerfile or CI workflow; `packslip verify --pin` then checks a release against it.

The fingerprint is derived from the forge's issuer and repository ID only. It stays the same when the repository is renamed, moves to another owner, or signs from another workflow, and a repository that later takes over the old name gets a different one. Only keyless releases whose certificate records a repository ID have one; for a key-signed release, pin the key with `packslip verify --pubkey`.

Verification works as in `packslip verify`: the policy is the one the project's name implies unless --identity, --identity-prefix, or --issuer replace it. See https://packslip.dev/docs/verifying/.
"""#
    flag --identity help="The exact certificate identity a keyless signer must have, including its ref, such as https://github.com/owner/repo/.github/workflows/release.yml@refs/tags/v1.2.3" help_heading=Trust {
        arg <IDENTITY>
    }
    flag --identity-prefix help="A prefix the certificate identity must start with, such as https://github.com/owner/repo/" help_heading=Trust {
        arg <IDENTITY_PREFIX>
    }
    flag --issuer help="The OIDC issuer a keyless signer must have; pass it with --identity or --identity-prefix, since alone it accepts any signer from that issuer" help_heading=Trust {
        arg <ISSUER>
    }
    flag --allow-unlogged help="Accept a bundle without a transparency log entry" help_heading=Trust
    flag --trusted-root help="A sigstore trusted_root.json to use instead of the embedded one" help_heading=Trust {
        arg <TRUSTED_ROOT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="Local release bundle to verify and fingerprint"
    complete bundle type=path
    complete trusted_root type=path
    example "packslip pin packslip.sigstore.json" header="Print the fingerprint of a release you already trust"
    exit_code 0 "Printed the signer fingerprint"
    exit_code 1 "Verification failed, the release has no signer fingerprint, or an input was unusable"
    exit_code 2 "The command line is invalid"
}
cmd releases help="Create and sign a project's release list" {
    long_help #"""
Create and sign a project's release list

Read local copies of released bundles and write a signed release list: each bundle's URL, digest, version, tag, and publish time, plus the list's sequence and expiry. The bundles are read, not verified, so give copies you trust. Repeat --release for every entry to keep; the command does not append to an earlier list or upload anything.

Publish the list at https://HOST/.well-known/packslip/PATH.json for a project named HOST/PATH, or at https://HOST/.well-known/packslip.json for a project named after a bare host. github.com does not serve that path, so a github.com project commits the list to its default branch instead, as its supplementary list: .well-known/packslip.json, or .well-known/packslip/TOOL.json for a monorepo tool. See https://packslip.dev/docs/release-lists/.
"""#
    flag --project help="The project's name, which every --release bundle must name" required=#true {
        arg <PROJECT>
    }
    flag --sequence help="This list's sequence number, which increases with every list you publish; consumers refuse a list whose sequence is lower than one they have accepted" required=#true {
        arg <SEQUENCE>
    }
    flag --latest help="Recommend this version for an unconstrained latest request, without reordering versions; it must exactly match the version of a --release entry" {
        arg <LATEST>
    }
    flag --valid-for help="How long until the list expires, as a number and a unit (s, m, h, d, or w), such as 30d" default="30d" {
        arg <VALID_FOR>
    }
    flag --generated-at help="RFC 3339 generation time; defaults to now" {
        arg <GENERATED_AT>
    }
    flag --release help="A released packslip as URL=PATH: where consumers fetch it, and the local copy to read (repeatable)" required=#true var=#true {
        arg <RELEASE>
    }
    flag --yank help="Withdraw a listed release, as URL=REASON, with URL exactly as given to --release (repeatable)" var=#true {
        arg <YANK>
    }
    flag --security help="Mark a listed release as a security fix, by its --release URL (repeatable)" var=#true {
        arg <SECURITY>
    }
    flag --evidence help="What a publisher other than the vendor checked about a listed release, as URL=KIND or URL=KIND=DETAIL (repeatable)" var=#true {
        arg <EVIDENCE>
    }
    flag "-k --key" help="Sign with this secret key instead of a CI identity" help_heading=Signing {
        arg <KEY>
    }
    flag --sign help="How to sign: oidc (keyless) or key (needs --key). Optional; inferred from whether --key is given" help_heading=Signing {
        arg <SIGN>
    }
    flag --no-log help="With --key: do not record the signature in Rekor. Consumers must then opt in with --allow-unlogged" help_heading=Signing
    flag --no-pin-workflow help="Keyless only: write identity.pin_workflow: false into the list, as `packslip create --no-pin-workflow` does for a release. See https://packslip.dev/release/v1/#reusable-workflows" help_heading=Signing
    flag "-o --out" help="Where to write the list; consumers fetch it only from its .well-known path, never under this default name" default=packslip-releases.sigstore.json {
        arg <OUT>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    complete key type=path
    example #"""
packslip releases \
        --project mytool.example.com \
        --sequence 1 --valid-for 30d \
        --latest 1.2.3 \
        --release https://mytool.example.com/v1.2.3/packslip.sigstore.json=releases/1.2.3/packslip.sigstore.json \
        --key release.key \
        --out site/.well-known/packslip.json
"""# header="List one key-signed release of a self-hosted project"
}
cmd schema help="Print the JSON schema for a decoded release statement" {
    long_help #"""
Print the JSON schema for a decoded release statement

Use --releases for the release-list statement schema. These schemas describe the in-toto payload, not the enclosing sigstore bundle. Both are published at https://packslip.dev/schema/release-v1.json and https://packslip.dev/schema/releases-v1.json.
"""#
    flag --releases help="Print the releases/v1 list schema instead of the release/v1 statement schema"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd show help="Print the statement inside a bundle, without verifying it" {
    flag --raw help="Print the signed payload followed by a newline, without pretty-printing"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="Release bundle or release list to read"
    complete bundle type=path
}
cmd usage help="Generate a usage spec for the CLI" hide=#true {
    long_help #"""
Generate a usage spec for the CLI

https://usage.jdx.dev
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd verify help="Verify a packslip, or a release list, against a pinned identity or key" {
    long_help #"""
Verify a packslip, or a release list, against a pinned identity or key

Check the signature, log evidence, and statement structure. With --artifact, also check local files against signed digests and artifact sizes. Without it, only the bundle is checked. Nothing is downloaded: remote artifacts and linked provenance are not fetched.

Choose what to trust. By default, the identity policy comes from the project the document claims, if it is on github.com or gitlab.com: that forge's issuer and any workflow of that repository. Any other project needs --pubkey or an identity flag. For a keyless release, --issuer with --identity-prefix (any workflow of a repository, such as https://github.com/owner/repo/) or --identity (one exact certificate identity, including its ref) replaces the derived policy, and only the flags you pass are checked: --issuer alone accepts any signer from that issuer. For a key-signed release, pass --pubkey. --pin adds a check on top of the identity policy: the signing repository must have that signer fingerprint.

Then match the verified project and version to what you meant to install. For a release list, the command does not check the expiry or compare the sequence with an earlier list. See https://packslip.dev/docs/verifying/.
"""#
    flag "-p --pubkey" help="The pinned public key file, or its base64 line" help_heading=Trust {
        arg <PUBKEY>
    }
    flag --identity help="The exact certificate identity a keyless signer must have, including its ref, such as https://github.com/owner/repo/.github/workflows/release.yml@refs/tags/v1.2.3" help_heading=Trust {
        arg <IDENTITY>
    }
    flag --identity-prefix help="A prefix the certificate identity must start with, such as https://github.com/owner/repo/" help_heading=Trust {
        arg <IDENTITY_PREFIX>
    }
    flag --issuer help="The OIDC issuer a keyless signer must have; pass it with --identity or --identity-prefix, since alone it accepts any signer from that issuer" help_heading=Trust {
        arg <ISSUER>
    }
    flag --pin help="The signer fingerprint (ps1_...) the certificate's repository must have, as `packslip pin` prints it" help_heading=Trust {
        arg <PIN>
    }
    flag --allow-unlogged help="Accept a bundle without a transparency log entry" help_heading=Trust
    flag --trusted-root help="A sigstore trusted_root.json to use instead of the embedded one" help_heading=Trust {
        arg <TRUSTED_ROOT>
    }
    flag "-a --artifact" help="A downloaded artifact or resource asset to check against the bundle, matched by file name, so keep the name it was published under (repeatable)" var=#true {
        arg <ARTIFACT>
    }
    flag "-J --json" help="Print the verified report as JSON, with source_repository when the signing certificate records one; for a release list, print the verified list statement" help_heading=Output
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <BUNDLE> help="Local release bundle or signed release list to verify"
    complete bundle type=path
    complete trusted_root type=path
    example #"""
packslip verify packslip.sigstore.json \
        --identity-prefix https://github.com/owner/repo/ \
        --issuer https://token.actions.githubusercontent.com \
        --artifact mytool-1.2.3-linux-x64.tar.gz
"""# header="Verify a GitHub release against its repository"
    example #"""
packslip verify packslip.sigstore.json \
        --pin ps1_snirenkjwr7m5ozgcufameodnm \
        --artifact hk-x86_64-unknown-linux-gnu.tar.gz
"""# header="Verify hk 2.3.0 against its signer fingerprint"
    example #"""
packslip verify packslip.sigstore.json \
        --pubkey release.pub \
        --artifact mytool-1.2.3-linux-x64.tar.gz
"""# header="Verify a key-signed release"
    exit_code 0 "The bundle verified, and every --artifact matched it"
    exit_code 1 "Verification failed, or an input was unusable: a file could not be read, a key or fingerprint is malformed, or the trust flags conflict or are missing"
    exit_code 2 "The command line is invalid"
}
cmd version help="Print packslip's version" {
    alias v
    flag "-J --json" help="Print the name, version, OS, and architecture as JSON"
    flag "-h --help" help="Print help" action=help builtin=#true
}
