// packslip.dev: the Hugo site as static assets, and the project's releases
// from R2 through cloudflare/worker.js. Deployed by .github/workflows/site.yml.
{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "packslip-dev",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "account_id": "6e243906ff257b965bcae8025c2fc344",
  "workers_dev": false,
  "routes": [{ "pattern": "packslip.dev", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "jdx-releases" }],
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "jdx_downloads" }],
  "vars": { "TOOL": "packslip" }
}
